# ==============================================================================
# MediTrack – Environment Variables Configuration (.env.example)
# Copy this file to .env or add these variables in your Vercel Project Settings.
# ==============================================================================

# Supabase API Endpoint (Find in Supabase Dashboard -> Project Settings -> API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Standard format aliases
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Application Environment
NODE_ENV=production
PORT=3000
